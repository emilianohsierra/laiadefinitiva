---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeaturedArticle from '../components/FeaturedArticle.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE_TITLE, SITE_DESCRIPTION, CATEGORIES } from '../consts';

const posts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const [featured, ...rest] = posts;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero">
				<p class="hero-eyebrow">Medios de IA, sin ruido</p>
				<h1 class="hero-title">La IA Definitiva</h1>
				<p class="hero-lead">
					Entiende la IA. Aprende a usarla. Construye con ella. Guías y comparativas honestas de
					herramientas de inteligencia artificial, probadas en proyectos reales.
				</p>
				<div class="hero-cta">
					<a class="btn" href="/blog/">Explorar el blog</a>
					<a class="btn btn-ghost" href="#newsletter">Recibir la newsletter</a>
				</div>
			</section>

			{featured && <FeaturedArticle post={featured} />}

			{
				rest.length > 0 && (
					<section class="block" aria-labelledby="latest-title">
						<div class="block-head">
							<h2 id="latest-title" class="block-title">
								Últimos artículos
							</h2>
							<a class="block-link" href="/blog/">
								Ver todo
							</a>
						</div>
						<div class="grid">
							{rest.map((post) => (
								<ArticleCard post={post} />
							))}
						</div>
					</section>
				)
			}

			{
				posts.length === 0 && (
					<section class="empty">
						<p>Muy pronto: los primeros artículos están en camino.</p>
					</section>
				)
			}

			<section class="block" aria-labelledby="cats-title">
				<div class="block-head">
					<h2 id="cats-title" class="block-title">Explora por categoría</h2>
				</div>
				<div class="cat-grid">
					{
						CATEGORIES.map((c) => (
							<a class="cat-tile" href={`/categoria/${c.slug}/`} style={`--h:${c.hue}`}>
								<span class="cat-tile-mono" aria-hidden="true">
									{c.name.slice(0, 2).toUpperCase()}
								</span>
								<span class="cat-tile-name">{c.name}</span>
							</a>
						))
					}
				</div>
			</section>

			<section id="newsletter" class="block">
				<Newsletter />
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		width: var(--page-max);
		max-width: calc(100% - 2 * var(--gutter));
	}

	/* Hero */
	.hero {
		padding: clamp(2.5rem, 1.5rem + 6vw, 6rem) 0 clamp(2rem, 1rem + 4vw, 4rem);
		text-align: center;
		max-width: 48rem;
		margin-inline: auto;
	}
	.hero-eyebrow {
		font-family: var(--font-display);
		font-size: var(--fs-eyebrow);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: var(--accent);
		margin: 0 0 var(--space-4);
	}
	.hero-title {
		font-size: var(--fs-h1);
		margin: 0 0 var(--space-4);
	}
	.hero-lead {
		font-size: var(--fs-lead);
		color: var(--text-muted);
		line-height: 1.5;
		margin: 0 auto var(--space-6);
		max-width: 40rem;
	}
	.hero-cta {
		display: flex;
		gap: var(--space-3);
		justify-content: center;
		flex-wrap: wrap;
	}

	/* Bloques */
	.block {
		margin-top: clamp(3rem, 2rem + 4vw, 5rem);
	}
	.block-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-4);
		margin-bottom: var(--space-5);
	}
	.block-title {
		margin: 0;
		font-size: var(--fs-h2);
	}
	.block-link {
		flex: 0 0 auto;
		color: var(--text-muted);
		text-decoration: none;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.95rem;
	}
	.block-link:hover {
		color: var(--accent);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-7) var(--space-5);
	}
	@media (max-width: 900px) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 600px) {
		.grid {
			grid-template-columns: 1fr;
			gap: var(--space-6);
		}
	}

	.empty {
		padding: var(--space-8) 0;
		text-align: center;
		color: var(--text-muted);
	}

	/* Grid de categorías */
	.cat-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: var(--space-4);
	}
	.cat-tile {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-4);
		border-radius: var(--radius);
		border: 1px solid var(--border);
		background:
			linear-gradient(135deg, hsl(var(--h) 70% 55% / 0.1), transparent 70%),
			var(--surface);
		color: var(--text);
		text-decoration: none;
		font-family: var(--font-display);
		font-weight: 600;
		transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease),
			box-shadow var(--dur) var(--ease);
	}
	.cat-tile:hover {
		transform: translateY(-2px);
		border-color: hsl(var(--h) 70% 55% / 0.6);
		box-shadow: var(--shadow);
	}
	.cat-tile-mono {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		flex: 0 0 auto;
		border-radius: 9px;
		font-size: 0.82rem;
		letter-spacing: -0.02em;
		color: #fff;
		background: linear-gradient(135deg, hsl(var(--h) 75% 52%), hsl(calc(var(--h) + 40) 75% 46%));
	}
	.cat-tile-name {
		font-size: 0.98rem;
	}
	@media (max-width: 820px) {
		.cat-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 420px) {
		.cat-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
