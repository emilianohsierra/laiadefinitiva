---
import { findCategory } from '../consts';

interface Props {
	title?: string;
	category?: string;
	ratio?: string;
	monogram?: string;
}
const { title = '', category, ratio = '16 / 9', monogram } = Astro.props;
const cat = findCategory(category);
const hue = cat?.hue ?? 258;
const tag = cat?.name ?? 'La IA Definitiva';
const mono = (monogram ?? cat?.name ?? title ?? 'IA').trim().slice(0, 2).toUpperCase();
---

<div class="brand-cover" style={`--h:${hue}; aspect-ratio:${ratio};`} aria-hidden="true">
	<div class="bc-glow"></div>
	<div class="bc-grid"></div>
	<span class="bc-mono">{mono}</span>
	<span class="bc-tag">{tag}</span>
</div>

<style>
	.brand-cover {
		position: relative;
		width: 100%;
		overflow: hidden;
		border-radius: inherit;
		display: grid;
		place-items: center;
		isolation: isolate;
		background:
			radial-gradient(130% 130% at 12% 0%, hsl(var(--h) 80% 24%) 0%, transparent 55%),
			radial-gradient(130% 120% at 100% 100%, hsl(calc(var(--h) + 46) 85% 30%) 0%, transparent 52%),
			linear-gradient(135deg, #0b0d16, #131022);
	}
	.bc-grid {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
		background-size: 38px 38px;
		-webkit-mask-image: radial-gradient(120% 100% at 50% 0%, #000 38%, transparent 88%);
		mask-image: radial-gradient(120% 100% at 50% 0%, #000 38%, transparent 88%);
	}
	.bc-glow {
		position: absolute;
		width: 62%;
		aspect-ratio: 1;
		border-radius: 50%;
		top: -14%;
		left: 18%;
		filter: blur(58px);
		background: hsl(var(--h) 90% 58% / 0.5);
	}
	.bc-mono {
		z-index: 1;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(2.4rem, 7vw, 4.6rem);
		letter-spacing: -0.05em;
		color: hsl(var(--h) 100% 93% / 0.92);
		text-shadow: 0 2px 34px hsl(var(--h) 90% 45% / 0.6);
	}
	.bc-tag {
		position: absolute;
		bottom: 0.85rem;
		left: 1.05rem;
		z-index: 1;
		font-family: var(--font-display);
		font-size: 0.7rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: #fff;
		opacity: 0.78;
	}
</style>
