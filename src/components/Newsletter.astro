---
// Sección de newsletter. El envío aún no tiene backend (action provisional).
---

<section class="nl" aria-labelledby="nl-title">
	<div class="nl-inner">
		<p class="nl-eyebrow">Newsletter</p>
		<h2 id="nl-title" class="nl-title">IA sin ruido</h2>
		<p class="nl-copy">
			Las mejores herramientas, tutoriales y estrategias de IA, directo a tu correo. Sin relleno,
			sin humo: solo lo que de verdad sirve.
		</p>
		<form class="nl-form" action="#" method="post">
			<input
				type="email"
				name="email"
				required
				placeholder="tu@correo.com"
				aria-label="Tu correo electrónico"
			/>
			<button type="submit" class="btn">Quiero recibirla</button>
		</form>
		<p class="nl-fine">Nada de spam. Te das de baja cuando quieras.</p>
	</div>
</section>

<style>
	.nl {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background:
			radial-gradient(120% 140% at 0% 0%, var(--accent-soft), transparent 55%),
			radial-gradient(120% 140% at 100% 100%, var(--cat-soft), transparent 55%),
			var(--surface);
		padding: clamp(2rem, 1rem + 5vw, 4rem);
		text-align: center;
	}
	.nl-inner {
		max-width: 34rem;
		margin-inline: auto;
	}
	.nl-eyebrow {
		font-family: var(--font-display);
		font-size: var(--fs-eyebrow);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--accent);
		margin: 0 0 var(--space-2);
	}
	.nl-title {
		font-size: clamp(1.7rem, 1.3rem + 1.8vw, 2.4rem);
		margin: 0 0 var(--space-3);
	}
	.nl-copy {
		color: var(--text-muted);
		margin: 0 auto var(--space-5);
	}
	.nl-form {
		display: flex;
		gap: var(--space-3);
		max-width: 26rem;
		margin: 0 auto var(--space-3);
	}
	.nl-form input {
		flex: 1;
		padding: 0.75em 1em;
		border-radius: var(--radius-full);
		border: 1px solid var(--border-strong);
		background: var(--bg);
		color: var(--text);
		font-size: 1rem;
		font-family: var(--font-sans);
	}
	.nl-form input:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
		border-color: var(--accent);
	}
	.nl-fine {
		font-size: var(--fs-small);
		color: var(--text-subtle);
		margin: 0;
	}
	@media (max-width: 520px) {
		.nl-form {
			flex-direction: column;
		}
		.nl-form .btn {
			justify-content: center;
		}
	}
</style>
