---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import CategoryBadge from './CategoryBadge.astro';
import BrandCover from './BrandCover.astro';
import { readingTime } from '../lib/reading-time';

interface Props {
	post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, pubDate, heroImage, heroImageAlt, category } = post.data;
const mins = readingTime(post.body);
const href = `/blog/${post.id}/`;
---

<article class="feat">
	<a class="feat-media" href={href} tabindex="-1" aria-hidden="true">
		{
			heroImage ? (
				<Image src={heroImage} alt={heroImageAlt || title} width={1200} height={675} loading="eager" />
			) : (
				<BrandCover title={title} category={category} ratio="16 / 9" />
			)
		}
	</a>
	<div class="feat-body">
		<div class="feat-eyebrow">
			<span class="star">Destacado</span>
			<CategoryBadge category={category} />
		</div>
		<h3 class="feat-title"><a href={href}>{title}</a></h3>
		<p class="feat-desc">{description}</p>
		<div class="feat-meta">
			<FormattedDate date={pubDate} /><span class="dot">·</span>{mins} min de lectura
		</div>
		<a class="btn" href={href}>Leer artículo</a>
	</div>
</article>

<style>
	.feat {
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		gap: var(--space-6);
		align-items: center;
		padding: var(--space-5);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
		box-shadow: var(--shadow-sm);
		transition: box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
	}
	.feat:hover {
		box-shadow: var(--shadow-lg);
		border-color: var(--border-strong);
	}
	.feat-media {
		display: block;
		border-radius: var(--radius);
		overflow: hidden;
		border: 1px solid var(--border);
	}
	.feat-media :global(img),
	.feat-media :global(.brand-cover) {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 0;
		transition: transform var(--dur-slow) var(--ease);
	}
	.feat:hover .feat-media :global(img),
	.feat:hover .feat-media :global(.brand-cover) {
		transform: scale(1.03);
	}
	.feat-eyebrow {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		margin-bottom: var(--space-3);
	}
	.star {
		font-family: var(--font-display);
		font-size: var(--fs-eyebrow);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--accent);
	}
	.feat-title {
		font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.1rem);
		line-height: 1.15;
		margin: 0 0 var(--space-3);
	}
	.feat-title a {
		color: var(--text);
		text-decoration: none;
		transition: color var(--dur) var(--ease);
	}
	.feat:hover .feat-title a {
		color: var(--accent);
	}
	.feat-desc {
		color: var(--text-muted);
		margin: 0 0 var(--space-4);
		font-size: 1.05rem;
	}
	.feat-meta {
		display: flex;
		align-items: center;
		gap: 0.5em;
		color: var(--text-subtle);
		font-size: var(--fs-small);
		margin-bottom: var(--space-5);
	}
	.dot {
		opacity: 0.5;
	}
	@media (max-width: 780px) {
		.feat {
			grid-template-columns: 1fr;
			gap: var(--space-5);
		}
	}
</style>
