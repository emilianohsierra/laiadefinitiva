---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import BrandCover from '../components/BrandCover.astro';
import TableOfContents from '../components/TableOfContents.astro';
import AuthorCard from '../components/AuthorCard.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import ArticleCTA from '../components/ArticleCTA.astro';
import ArticleSchema from '../components/ArticleSchema.astro';
import { readingTime } from '../lib/reading-time';
import { extractFaq } from '../lib/faq';
import { findCategory, SITE_AUTHOR } from '../consts';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}
type Props = CollectionEntry<'blog'>['data'] & {
	id: string;
	body?: string;
	headings: Heading[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroImageAlt,
	category,
	author,
	id,
	body,
	headings,
} = Astro.props;

const cat = findCategory(category);
const mins = readingTime(body);
const faqs = extractFaq(body);
const authorName = author || SITE_AUTHOR;
const imageUrl = heroImage ? new URL(heroImage.src, Astro.site ?? Astro.url).href : undefined;
---

<html lang="es">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<ArticleSchema
			title={title}
			description={description}
			pubDate={pubDate}
			updatedDate={updatedDate}
			author={author}
			categoryName={cat?.name}
			categorySlug={cat?.slug}
			imageUrl={imageUrl}
			faqs={faqs}
		/>
	</head>

	<body>
		<Header />
		<main class="article">
			<article class="a-grid">
				<header class="a-head">
					<nav class="crumbs" aria-label="Ruta">
						<a href="/">Inicio</a>
						<span aria-hidden="true">/</span>
						<a href="/blog/">Blog</a>
						{
							cat && (
								<>
									<span aria-hidden="true">/</span>
									<a href={`/categoria/${cat.slug}/`}>{cat.name}</a>
								</>
							)
						}
					</nav>
					{cat && <CategoryBadge category={category} />}
					<h1 class="a-title">{title}</h1>
					<p class="a-desc">{description}</p>
					<div class="a-meta">
						<span class="a-author">Por {authorName}</span>
						<span class="dot">·</span>
						<FormattedDate date={pubDate} />
						<span class="dot">·</span>
						<span>{mins} min de lectura</span>
						{
							updatedDate && (
								<>
									<span class="dot">·</span>
									<span class="a-updated">
										Actualizado el <FormattedDate date={updatedDate} />
									</span>
								</>
							)
						}
					</div>
				</header>

				<figure class="a-hero">
					{
						heroImage ? (
							<Image
								src={heroImage}
								alt={heroImageAlt || title}
								width={1200}
								height={675}
								loading="eager"
								fetchpriority="high"
							/>
						) : (
							<BrandCover title={title} category={category} ratio="16 / 9" />
						)
					}
				</figure>

				<aside class="a-side">
					<TableOfContents headings={headings} />
				</aside>

				<div class="prose">
					<slot />
				</div>

				<footer class="a-foot">
					<AuthorCard name={author} />
					<ArticleCTA />
					<RelatedArticles currentId={id} category={category} />
				</footer>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article {
		width: var(--page-max);
		max-width: calc(100% - 2 * var(--gutter));
		padding-top: var(--space-6);
	}

	.a-grid {
		display: grid;
		grid-template-columns: minmax(0, var(--prose-width)) minmax(0, 15rem);
		grid-template-areas:
			'head side'
			'hero side'
			'body side'
			'foot side';
		justify-content: center;
		gap: 0 var(--space-8);
		align-items: start;
	}

	.a-head {
		grid-area: head;
		margin-bottom: var(--space-6);
	}
	.a-hero {
		grid-area: hero;
		margin: 0 0 var(--space-7);
	}
	.a-side {
		grid-area: side;
		position: sticky;
		top: 88px;
		align-self: start;
	}
	.prose {
		grid-area: body;
		min-width: 0;
	}
	.a-foot {
		grid-area: foot;
		margin-top: var(--space-8);
		display: flex;
		flex-direction: column;
		gap: var(--space-7);
	}

	/* Cabecera del artículo */
	.crumbs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5em;
		font-size: var(--fs-small);
		color: var(--text-subtle);
		margin-bottom: var(--space-4);
	}
	.crumbs a {
		color: var(--text-muted);
		text-decoration: none;
	}
	.crumbs a:hover {
		color: var(--accent);
	}
	.a-title {
		margin: var(--space-3) 0 var(--space-4);
	}
	.a-desc {
		font-size: var(--fs-lead);
		line-height: 1.5;
		color: var(--text-muted);
		margin: 0 0 var(--space-5);
	}
	.a-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5em;
		color: var(--text-subtle);
		font-size: var(--fs-small);
		padding-top: var(--space-4);
		border-top: 1px solid var(--border);
	}
	.a-author {
		color: var(--text-muted);
		font-weight: 550;
	}
	.dot {
		opacity: 0.5;
	}

	/* Hero */
	.a-hero :global(img),
	.a-hero :global(.brand-cover) {
		width: 100%;
		height: auto;
		display: block;
		border-radius: var(--radius-lg);
		border: 1px solid var(--border);
		box-shadow: var(--shadow-sm);
	}

	@media (max-width: 1023px) {
		.a-grid {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas:
				'head'
				'hero'
				'side'
				'body'
				'foot';
			justify-content: stretch;
		}
		.a-side {
			position: static;
			margin-bottom: var(--space-6);
		}
	}
</style>
